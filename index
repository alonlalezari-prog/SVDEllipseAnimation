<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SVD Geometric Animation: A = U Σ Vᵀ</title>
<style>
  :root {
    --bg: #070b14;
    --panel: rgba(13, 19, 34, 0.82);
    --border: rgba(148, 163, 184, 0.18);
    --text: #e2e8f0;
    --muted: #94a3b8;
    --teal: #2dd4bf;
    --orange: #fb923c;
    --gold: #facc15;
    --cyan: #38bdf8;
    --amber: #f59e0b;
    --purple: #a855f7;
  }
  * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    overflow: hidden; background: var(--bg); color: var(--text);
    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  }
  canvas {
    display: block; width: 100%; height: 100%; cursor: grab;
  }
  canvas:active { cursor: grabbing; }

  .hud {
    position: fixed; pointer-events: none; z-index: 10;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 14px; box-shadow: 0 12px 32px rgba(0,0,0,0.45);
  }
  .hud * { pointer-events: auto; }

  /* Top-left math matrix badge */
  .top-left {
    top: 14px; left: 14px; padding: 10px 14px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .eq-row {
    display: flex; align-items: center; gap: 7px;
    font-size: 15px; font-weight: 700; letter-spacing: 0.2px;
  }
  .mat {
    display: inline-grid; grid-template-columns: auto auto; gap: 1px 8px;
    padding: 3px 7px; border-left: 2px solid currentColor; border-right: 2px solid currentColor;
    border-radius: 5px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px; font-weight: 600; text-align: right; line-height: 1.25;
  }
  .pill-tag {
    padding: 2px 7px; border-radius: 999px; font-size: 12px; font-weight: 700;
    border: 1px solid transparent; transition: all 0.2s;
  }
  .pill-tag.active { transform: scale(1.06); box-shadow: 0 0 14px currentColor; }
  .c-u { color: var(--purple); }
  .c-s { color: var(--amber); }
  .c-v { color: var(--cyan); }
  .c-a { color: #e2e8f0; }

  .matrices-strip {
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  }
  .mat-box {
    display: flex; align-items: center; gap: 4px; padding: 4px 6px;
    border-radius: 8px; border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.02); transition: all 0.25s; opacity: 0.55;
  }
  .mat-box.active {
    opacity: 1; background: rgba(255,255,255,0.07);
    border-color: currentColor; box-shadow: 0 0 16px -4px currentColor;
  }

  /* Top-right vector & length gauge */
  .top-right {
    top: 14px; right: 14px; padding: 10px 14px; min-width: 220px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .vec-readout {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px;
  }
  .vec-badge {
    display: inline-flex; align-items: center; gap: 6px; font-weight: 700;
  }
  .dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }

  .gauge-wrap { display: flex; flex-direction: column; gap: 4px; }
  .gauge-head {
    display: flex; justify-content: space-between; font-size: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 700;
  }
  .gauge-track {
    position: relative; height: 10px; border-radius: 999px;
    background: rgba(255,255,255,0.08); overflow: visible;
  }
  .gauge-fill {
    height: 100%; border-radius: 999px; width: 15%;
    background: linear-gradient(90deg, var(--teal), var(--gold), var(--orange));
    box-shadow: 0 0 12px rgba(250, 204, 21, 0.5);
    transition: width 0.04s linear;
  }
  .tick-mark {
    position: absolute; top: -3px; width: 2px; height: 16px; border-radius: 2px;
  }
  .tick-lbl {
    position: absolute; top: 14px; transform: translateX(-50%);
    font-size: 9px; font-family: ui-monospace, monospace; color: var(--muted);
  }

  /* Bottom control dock */
  .bottom-dock {
    bottom: 14px; left: 50%; transform: translateX(-50%);
    padding: 10px 14px; display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap; justify-content: center; max-width: calc(100vw - 24px);
  }

  .btn {
    border: 1px solid var(--border); background: rgba(255,255,255,0.06);
    color: var(--text); border-radius: 10px; padding: 7px 11px;
    font-size: 13px; font-weight: 700; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    transition: all 0.15s;
  }
  .btn:hover { background: rgba(255,255,255,0.13); transform: translateY(-1px); }
  .btn.primary {
    background: linear-gradient(135deg, #0ea5e9, #6366f1);
    border-color: rgba(255,255,255,0.25); color: #fff;
  }
  .btn.active {
    border-color: var(--gold); background: rgba(250, 204, 21, 0.16); color: var(--gold);
  }

  .step-pills {
    display: flex; align-items: center; gap: 6px;
  }
  .step-btn {
    padding: 5px 9px; border-radius: 10px; border: 1px solid var(--border);
    background: rgba(255,255,255,0.03); color: var(--muted);
    cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 2px;
    font-size: 11px; font-weight: 700; transition: all 0.2s; min-width: 54px;
  }
  .step-btn:hover { background: rgba(255,255,255,0.09); color: var(--text); }
  .step-btn.active {
    color: #fff; background: rgba(255,255,255,0.12);
    border-color: currentColor; box-shadow: 0 0 14px -4px currentColor;
  }

  .slider-wrap {
    display: flex; align-items: center; gap: 8px; min-width: 150px;
  }
  input[type="range"] {
    -webkit-appearance: none; appearance: none; width: 155px; height: 6px;
    border-radius: 999px; background: rgba(255,255,255,0.14); outline: none; cursor: pointer;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%;
    background: #fff; border: 3px solid var(--cyan); box-shadow: 0 0 10px var(--cyan);
  }

  .presets { display: flex; align-items: center; gap: 5px; }
  .preset-btn {
    padding: 6px 9px; border-radius: 9px; border: 1px solid var(--border);
    background: rgba(255,255,255,0.04); color: var(--text);
    font-family: ui-monospace, monospace; font-size: 12px; font-weight: 700;
    cursor: pointer; transition: all 0.15s;
  }
  .preset-btn:hover { background: rgba(255,255,255,0.11); }
  .preset-btn.active { background: rgba(255,255,255,0.15); border-color: currentColor; }

  @media (max-width: 760px) {
    .top-left, .top-right { padding: 8px 10px; }
    .matrices-strip { display: none; }
    .bottom-dock { gap: 7px; padding: 8px 10px; }
    input[type="range"] { width: 110px; }
  }
</style>
</head>
<body>

<canvas id="scene"></canvas>

<!-- Top-Left: Compact Color-Coded SVD Formula -->
<div class="hud top-left">
  <div class="eq-row">
    <span class="c-a">A</span>
    <span class="mat c-a"><span>3</span><span>0</span><span>4</span><span>5</span></span>
    <span>=</span>
    <span id="tag-u" class="pill-tag c-u">U</span>
    <span id="tag-s" class="pill-tag c-s">Σ</span>
    <span id="tag-v" class="pill-tag c-v">Vᵀ</span>
  </div>
  <div class="matrices-strip">
    <div id="box-u" class="mat-box c-u">
      <span style="font-size:11px;font-weight:700">U</span>
      <span class="mat"><span>.32</span><span>.95</span><span>.95</span><span>-.32</span></span>
    </div>
    <div id="box-s" class="mat-box c-s">
      <span style="font-size:11px;font-weight:700">Σ</span>
      <span class="mat"><span>6.71</span><span>0</span><span>0</span><span>2.24</span></span>
    </div>
    <div id="box-v" class="mat-box c-v">
      <span style="font-size:11px;font-weight:700">Vᵀ</span>
      <span class="mat"><span>.71</span><span>.71</span><span>.71</span><span>-.71</span></span>
    </div>
  </div>
</div>

<!-- Top-Right: Live Vector & Length Meter -->
<div class="hud top-right">
  <div class="vec-readout">
    <span class="vec-badge" style="color:var(--gold)">
      <span class="dot" style="background:var(--gold)"></span>
      <span id="vec-label">x</span>
    </span>
    <span id="vec-coords">(1.00, 0.00)</span>
  </div>
  <div class="vec-readout" style="font-size:11px; color:var(--muted)">
    <span>Ax = <b id="ax-coords" style="color:#fff">(3.00, 4.00)</b></span>
    <span style="color:var(--teal)">σ₁=6.71</span>
    <span style="color:var(--orange)">σ₂=2.24</span>
  </div>
  <div class="gauge-wrap" style="margin-bottom:10px">
    <div class="gauge-head">
      <span style="color:var(--muted)">‖T(x)‖</span>
      <span id="len-val" style="color:var(--gold)">1.00</span>
    </div>
    <div class="gauge-track">
      <div id="gauge-fill" class="gauge-fill"></div>
      <div class="tick-mark" style="left:14.9%; background:#fff; opacity:.5"><span class="tick-lbl">1</span></div>
      <div class="tick-mark" style="left:33.3%; background:var(--orange)"><span class="tick-lbl" style="color:var(--orange)">σ₂</span></div>
      <div class="tick-mark" style="left:74.5%; background:#f472b6"><span class="tick-lbl" style="color:#f472b6">5</span></div>
      <div class="tick-mark" style="left:100%; background:var(--teal)"><span class="tick-lbl" style="color:var(--teal)">σ₁</span></div>
    </div>
  </div>
</div>

<!-- Bottom: Visual Timeline & Vector Presets -->
<div class="hud bottom-dock">
  <button id="play-btn" class="btn primary" title="Play / Pause (Space)">
    <svg id="play-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
    <span id="play-txt">Play</span>
  </button>

  <div class="step-pills">
    <button class="step-btn active" data-step="0" style="color:#e2e8f0">
      <svg width="26" height="18" viewBox="0 0 32 22"><circle cx="16" cy="11" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><line x1="16" y1="11" x2="24" y2="11" stroke="#facc15" stroke-width="2"/></svg>
      <span>0 · x</span>
    </button>
    <button class="step-btn" data-step="1" style="color:var(--cyan)">
      <svg width="26" height="18" viewBox="0 0 32 22"><circle cx="16" cy="11" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><line x1="16" y1="11" x2="21.5" y2="5.5" stroke="#facc15" stroke-width="2"/></svg>
      <span>1 · Vᵀ</span>
    </button>
    <button class="step-btn" data-step="2" style="color:var(--amber)">
      <svg width="26" height="18" viewBox="0 0 32 22"><ellipse cx="16" cy="11" rx="13" ry="5" fill="none" stroke="currentColor" stroke-width="1.8"/><line x1="16" y1="11" x2="25" y2="7.5" stroke="#facc15" stroke-width="2"/></svg>
      <span>2 · Σ</span>
    </button>
    <button class="step-btn" data-step="3" style="color:var(--purple)">
      <svg width="26" height="18" viewBox="0 0 32 22"><ellipse cx="16" cy="11" rx="13" ry="5" transform="rotate(-71 16 11)" fill="none" stroke="currentColor" stroke-width="1.8"/><line x1="16" y1="11" x2="21" y2="5" stroke="#facc15" stroke-width="2"/></svg>
      <span>3 · U</span>
    </button>
  </div>

  <div class="slider-wrap">
    <input id="scrubber" type="range" min="0" max="3" step="0.005" value="0" />
  </div>

  <div class="presets">
    <button class="preset-btn active" data-preset="e1" style="color:var(--gold)">(1,0)</button>
    <button class="preset-btn" data-preset="v1" style="color:var(--teal)">v₁</button>
    <button class="preset-btn" data-preset="v2" style="color:var(--orange)">v₂</button>
    <button id="ghost-btn" class="btn active" title="Toggle Final Ghost & Trails">Trails</button>
  </div>
</div>

<script>
(() => {
  const canvas = document.getElementById('scene');
  const ctx = canvas.getContext('2d');

  // Exact SVD constants for A = [[3, 0], [4, 5]]
  const SQRT2 = Math.SQRT2;
  const SQRT5 = Math.sqrt(5);
  const SQRT10 = Math.sqrt(10);
  const s1 = 3 * SQRT5; // 6.7082039
  const s2 = SQRT5;     // 2.2360679

  const Vt = [[1 / SQRT2, 1 / SQRT2], [1 / SQRT2, -1 / SQRT2]];
  const Sigma = [[s1, 0], [0, s2]];
  const U = [[1 / SQRT10, 3 / SQRT10], [3 / SQRT10, -1 / SQRT10]];
  const A = [[3, 0], [4, 5]];

  const v1 = [1 / SQRT2, 1 / SQRT2];
  const v2 = [1 / SQRT2, -1 / SQRT2];

  // State
  let xVec = [1, 0];
  let progress = 0; // 0..3
  let playing = false;
  let showTrails = true;
  let dragging = false;
  let lastTime = performance.now();

  // DOM refs
  const scrubber = document.getElementById('scrubber');
  const playBtn = document.getElementById('play-btn');
  const playTxt = document.getElementById('play-txt');
  const playIcon = document.getElementById('play-icon');
  const ghostBtn = document.getElementById('ghost-btn');
  const vecLabel = document.getElementById('vec-label');
  const vecCoords = document.getElementById('vec-coords');
  const axCoords = document.getElementById('ax-coords');
  const lenVal = document.getElementById('len-val');
  const gaugeFill = document.getElementById('gauge-fill');
  const stepBtns = [...document.querySelectorAll('.step-btn')];
  const presetBtns = [...document.querySelectorAll('.preset-btn')];
  const tags = {
    v: document.getElementById('tag-v'), s: document.getElementById('tag-s'), u: document.getElementById('tag-u'),
    bv: document.getElementById('box-v'), bs: document.getElementById('box-s'), bu: document.getElementById('box-u')
  };

  // Math helpers
  const ease = t => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  const mulMat = (M, N) => [
    [M[0][0]*N[0][0] + M[0][1]*N[1][0], M[0][0]*N[0][1] + M[0][1]*N[1][1]],
    [M[1][0]*N[0][0] + M[1][1]*N[1][0], M[1][0]*N[0][1] + M[1][1]*N[1][1]]
  ];
  const mulVec = (M, v) => [M[0][0]*v[0] + M[0][1]*v[1], M[1][0]*v[0] + M[1][1]*v[1]];
  const reflectInterp = (R, t) => {
    const c = Math.cos(Math.PI * t);
    const a = 0.5 * (1 + c), b = 0.5 * (1 - c);
    return [[a + b*R[0][0], b*R[0][1]], [b*R[1][0], a + b*R[1][1]]];
  };

  function getTransform(p) {
    if (p <= 1) return reflectInterp(Vt, ease(p));
    if (p <= 2) {
      const t = ease(p - 1);
      const S = [[1 + (s1 - 1)*t, 0], [0, 1 + (s2 - 1)*t]];
      return mulMat(S, Vt);
    }
    const t = ease(p - 2);
    return mulMat(reflectInterp(U, t), mulMat(Sigma, Vt));
  }

  function invMat(M) {
    const det = M[0][0]*M[1][1] - M[0][1]*M[1][0];
    if (Math.abs(det) < 0.12) return null;
    return [[M[1][1]/det, -M[0][1]/det], [-M[1][0]/det, M[0][0]/det]];
  }

  // Coordinate system
  let W = 0, H = 0, scale = 50, cx = 0, cy = 0;
  function resize() {
    const dpr = window.devicePixelRatio || 1;
    W = window.innerWidth; H = window.innerHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    scale = Math.min(W / 16.5, H / 15.2);
    cx = W * 0.5;
    cy = H * 0.50;
  }
  window.addEventListener('resize', resize);
  resize();

  const toScreen = ([x, y]) => [cx + x * scale, cy - y * scale];
  const toWorld = (sx, sy) => [(sx - cx) / scale, (cy - sy) / scale];

  // Drawing primitives
  function drawArrow(from, to, color, width = 3, label = '', alpha = 1, glow = false) {
    const [x1, y1] = toScreen(from);
    const [x2, y2] = toScreen(to);
    const dx = x2 - x1, dy = y2 - y1;
    const len = Math.hypot(dx, dy);
    if (len < 1) return;
    const ang = Math.atan2(dy, dx);
    const head = Math.min(13, Math.max(7, len * 0.25));

    ctx.save();
    ctx.globalAlpha = alpha;
    if (glow) {
      ctx.shadowColor = color;
      ctx.shadowBlur = 12;
    }
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = width;
    ctx.lineCap = 'round';

    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2 - Math.cos(ang) * head * 0.65, y2 - Math.sin(ang) * head * 0.65);
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - head * Math.cos(ang - 0.42), y2 - head * Math.sin(ang - 0.42));
    ctx.lineTo(x2 - head * Math.cos(ang + 0.42), y2 - head * Math.sin(ang + 0.42));
    ctx.closePath();
    ctx.fill();

    if (label) {
      ctx.shadowBlur = 0;
      const nx = Math.cos(ang), ny = Math.sin(ang);
      const lx = x2 + nx * 16;
      const ly = y2 + ny * 16;
      ctx.font = '700 13px ui-monospace, SFMono-Regular, Menlo, monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = color;
      ctx.fillText(label, lx, ly);
    }
    ctx.restore();
  }

  function drawCircleOrEllipse(M, stroke, fill, lineWidth = 2, dash = []) {
    ctx.save();
    ctx.setLineDash(dash);
    ctx.strokeStyle = stroke;
    ctx.fillStyle = fill;
    ctx.lineWidth = lineWidth;
    ctx.beginPath();
    const steps = 120;
    for (let i = 0; i <= steps; i++) {
      const th = (i / steps) * Math.PI * 2;
      const p = mulVec(M, [Math.cos(th), Math.sin(th)]);
      const [sx, sy] = toScreen(p);
      if (i === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
    }
    ctx.closePath();
    if (fill) ctx.fill();
    ctx.stroke();
    ctx.restore();
  }

  function drawTransformedGrid(M) {
    ctx.save();
    ctx.lineWidth = 1;
    for (let i = -3; i <= 3; i++) {
      ctx.strokeStyle = i === 0 ? 'rgba(56, 189, 248, 0.25)' : 'rgba(56, 189, 248, 0.09)';
      const [a1, a2] = [toScreen(mulVec(M, [i, -3])), toScreen(mulVec(M, [i, 3]))];
      ctx.beginPath(); ctx.moveTo(a1[0], a1[1]); ctx.lineTo(a2[0], a2[1]); ctx.stroke();

      const [b1, b2] = [toScreen(mulVec(M, [-3, i])), toScreen(mulVec(M, [3, i]))];
      ctx.beginPath(); ctx.moveTo(b1[0], b1[1]); ctx.lineTo(b2[0], b2[1]); ctx.stroke();
    }
    ctx.restore();
  }

  function drawStaticAxes() {
    ctx.save();
    // Minor world grid
    ctx.lineWidth = 1;
    for (let i = -10; i <= 10; i++) {
      ctx.strokeStyle = i === 0 ? 'rgba(255,255,255,0.22)' : 'rgba(255,255,255,0.045)';
      const [vx] = toScreen([i, 0]);
      ctx.beginPath(); ctx.moveTo(vx, 0); ctx.lineTo(vx, H); ctx.stroke();
      const [, hy] = toScreen([0, i]);
      ctx.beginPath(); ctx.moveTo(0, hy); ctx.lineTo(W, hy); ctx.stroke();
    }

    // Numeric ticks
    ctx.font = '600 10px ui-monospace, monospace';
    ctx.fillStyle = 'rgba(148, 163, 184, 0.55)';
    for (let i = -7; i <= 7; i++) {
      if (i === 0) continue;
      const [tx, ty] = toScreen([i, 0]);
      ctx.textAlign = 'center'; ctx.fillText(i, tx, ty + 12);
      const [lx, ly] = toScreen([0, i]);
      ctx.textAlign = 'right'; ctx.fillText(i, lx - 6, ly + 3);
    }

    // Singular value radius rings (visual proof of ||A||_2 = sigma_1 and min = sigma_2)
    ctx.setLineDash([4, 6]);
    ctx.strokeStyle = 'rgba(45, 212, 191, 0.22)';
    ctx.lineWidth = 1.3;
    ctx.beginPath(); ctx.arc(cx, cy, s1 * scale, 0, Math.PI * 2); ctx.stroke();

    ctx.strokeStyle = 'rgba(251, 146, 60, 0.22)';
    ctx.beginPath(); ctx.arc(cx, cy, s2 * scale, 0, Math.PI * 2); ctx.stroke();

    ctx.fillStyle = 'rgba(45, 212, 191, 0.65)';
    ctx.textAlign = 'left';
    ctx.fillText('σ₁ = 6.71', cx + 6, cy - s1 * scale + 13);
    ctx.fillStyle = 'rgba(251, 146, 60, 0.65)';
    ctx.fillText('σ₂ = 2.24', cx + 6, cy - s2 * scale + 13);
    ctx.restore();
  }

  function drawStageOverlays(p) {
    ctx.save();
    // Stage 1: Mirror line for V^T (angle 22.5 deg)
    if (p > 0.02 && p < 0.98) {
      const th = 0.5 * Math.atan2(Vt[1][0], Vt[0][0]);
      const p1 = toScreen([Math.cos(th)*9, Math.sin(th)*9]);
      const p2 = toScreen([-Math.cos(th)*9, -Math.sin(th)*9]);
      ctx.setLineDash([7, 6]);
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.55)';
      ctx.lineWidth = 1.8;
      ctx.beginPath(); ctx.moveTo(p1[0], p1[1]); ctx.lineTo(p2[0], p2[1]); ctx.stroke();
    }
    // Stage 2: Stretch arrows along x and y axes
    if (p > 1.02 && p < 2.02) {
      const t = ease(Math.min(1, p - 1));
      const rx = 1 + (s1 - 1) * t;
      const ry = 1 + (s2 - 1) * t;
      drawArrow([1, 0], [rx, 0], 'rgba(245, 158, 11, 0.75)', 2, `×${rx.toFixed(2)}`);
      drawArrow([-1, 0], [-rx, 0], 'rgba(245, 158, 11, 0.75)', 2);
      drawArrow([0, 1], [0, ry], 'rgba(245, 158, 11, 0.75)', 2, `×${ry.toFixed(2)}`);
      drawArrow([0, -1], [0, -ry], 'rgba(245, 158, 11, 0.75)', 2);
    }
    // Stage 3: Mirror line for U
    if (p > 2.02 && p < 2.98) {
      const th = 0.5 * Math.atan2(U[1][0], U[0][0]);
      const p1 = toScreen([Math.cos(th)*9, Math.sin(th)*9]);
      const p2 = toScreen([-Math.cos(th)*9, -Math.sin(th)*9]);
      ctx.setLineDash([7, 6]);
      ctx.strokeStyle = 'rgba(168, 85, 247, 0.55)';
      ctx.lineWidth = 1.8;
      ctx.beginPath(); ctx.moveTo(p1[0], p1[1]); ctx.lineTo(p2[0], p2[1]); ctx.stroke();
    }
    ctx.restore();
  }

  function updateHUD(T, curX) {
    const len = Math.hypot(curX[0], curX[1]);
    const ax = mulVec(A, xVec);

    // Label
    const stageIdx = Math.round(progress);
    const names = ['x', 'Vᵀx', 'ΣVᵀx', 'Ax'];
    vecLabel.textContent = progress < 0.05 ? 'x' :
      progress <= 1.05 ? 'Vᵀx' :
      progress <= 2.05 ? 'ΣVᵀx' : 'Ax';

    vecCoords.textContent = `(${curX[0].toFixed(2)}, ${curX[1].toFixed(2)})`;
    axCoords.textContent = `(${ax[0].toFixed(2)}, ${ax[1].toFixed(2)})`;
    lenVal.textContent = len.toFixed(2);
    gaugeFill.style.width = `${Math.min(100, (len / s1) * 100)}%`;

    // Active step highlight
    stepBtns.forEach((b, idx) => b.classList.toggle('active', idx === stageIdx));
    const in1 = progress > 0.02 && progress <= 1.02;
    const in2 = progress > 1.02 && progress <= 2.02;
    const in3 = progress > 2.02;
    tags.v.classList.toggle('active', in1); tags.bv.classList.toggle('active', in1);
    tags.s.classList.toggle('active', in2); tags.bs.classList.toggle('active', in2);
    tags.u.classList.toggle('active', in3); tags.bu.classList.toggle('active', in3);
  }

  function render() {
    ctx.clearRect(0, 0, W, H);
    const T = getTransform(progress);

    drawStaticAxes();
    drawTransformedGrid(T);

    // Ghost references
    if (showTrails) {
      drawCircleOrEllipse([[1,0],[0,1]], 'rgba(255,255,255,0.16)', null, 1.3, [4, 4]);
      drawCircleOrEllipse(A, 'rgba(168, 85, 247, 0.24)', null, 1.4, [4, 4]);
    }

    // Active morphing unit circle -> ellipse
    drawCircleOrEllipse(T, '#38bdf8', 'rgba(56, 189, 248, 0.08)', 2.4);

    drawStageOverlays(progress);

    // Transform basis vectors v1 (teal) and v2 (orange)
    const tv1 = mulVec(T, v1);
    const tv2 = mulVec(T, v2);
    const lbl1 = progress < 0.4 ? 'v₁' : progress < 1.4 ? 'e₁' : progress < 2.4 ? 'σ₁e₁' : 'σ₁u₁';
    const lbl2 = progress < 0.4 ? 'v₂' : progress < 1.4 ? 'e₂' : progress < 2.4 ? 'σ₂e₂' : 'σ₂u₂';
    drawArrow([0, 0], tv1, '#2dd4bf', 3.2, lbl1, 0.95);
    drawArrow([0, 0], tv2, '#fb923c', 3.2, lbl2, 0.95);

    // Trail of x from 0 -> progress
    if (showTrails && progress > 0.02) {
      ctx.save();
      ctx.setLineDash([4, 4]);
      ctx.strokeStyle = 'rgba(250, 204, 21, 0.55)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      const samples = Math.max(20, Math.ceil(progress * 32));
      for (let i = 0; i <= samples; i++) {
        const sp = (i / samples) * progress;
        const pt = mulVec(getTransform(sp), xVec);
        const [sx, sy] = toScreen(pt);
        if (i === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
      }
      ctx.stroke();

      // Milestone dots at 0, 1, 2, 3
      for (let m = 0; m <= 3; m++) {
        if (progress >= m) {
          const mp = mulVec(getTransform(m), xVec);
          const [mx, my] = toScreen(mp);
          ctx.setLineDash([]);
          ctx.fillStyle = m === 0 ? '#e2e8f0' : m === 1 ? '#38bdf8' : m === 2 ? '#f59e0b' : '#a855f7';
          ctx.beginPath(); ctx.arc(mx, my, 4.2, 0, Math.PI * 2); ctx.fill();
        }
      }

      // Target Ax crosshair
      const target = mulVec(A, xVec);
      const [tx, ty] = toScreen(target);
      ctx.setLineDash([]);
      ctx.strokeStyle = 'rgba(250, 204, 21, 0.45)';
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.arc(tx, ty, 8, 0, Math.PI * 2); ctx.stroke();
      ctx.restore();
    }

    // Tracked vector x (gold, glowing, draggable handle)
    const curX = mulVec(T, xVec);
    drawArrow([0, 0], curX, '#facc15', 4, '', 1, true);
    const [hx, hy] = toScreen(curX);
    ctx.save();
    ctx.fillStyle = '#facc15';
    ctx.strokeStyle = '#070b14';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(hx, hy, dragging ? 7.5 : 5.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.restore();

    updateHUD(T, curX);
  }

  // Animation loop
  let targetStep = null;
  function tick(now) {
    const dt = Math.min(0.05, (now - lastTime) / 1000);
    lastTime = now;

    if (playing) {
      progress += dt * 0.62;
      if (progress >= 3) {
        progress = 3;
        setPlaying(false);
      }
      scrubber.value = progress;
    } else if (targetStep !== null) {
      const diff = targetStep - progress;
      if (Math.abs(diff) < 0.008) {
        progress = targetStep;
        targetStep = null;
      } else {
        progress += diff * Math.min(1, dt * 9);
      }
      scrubber.value = progress;
    }

    render();
    requestAnimationFrame(tick);
  }

  function setPlaying(val) {
    playing = val;
    if (playing && progress >= 2.99) progress = 0;
    targetStep = null;
    playTxt.textContent = playing ? 'Pause' : 'Play';
    playIcon.innerHTML = playing
      ? '<rect x="5" y="4" width="5" height="16"/><rect x="14" y="4" width="5" height="16"/>'
      : '<polygon points="5,3 19,12 5,21"/>';
  }

  // Controls
  playBtn.addEventListener('click', () => setPlaying(!playing));
  scrubber.addEventListener('input', () => {
    setPlaying(false);
    targetStep = null;
    progress = parseFloat(scrubber.value);
  });

  stepBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      setPlaying(false);
      targetStep = parseFloat(btn.dataset.step);
    });
  });

  function setPreset(name) {
    presetBtns.forEach(b => b.classList.toggle('active', b.dataset.preset === name));
    if (name === 'e1') xVec = [1, 0];
    else if (name === 'v1') xVec = [...v1];
    else if (name === 'v2') xVec = [...v2];
  }
  presetBtns.forEach(btn => btn.addEventListener('click', () => setPreset(btn.dataset.preset)));

  ghostBtn.addEventListener('click', () => {
    showTrails = !showTrails;
    ghostBtn.classList.toggle('active', showTrails);
  });

  // Dragging x directly on the canvas
  function handleDrag(clientX, clientY) {
    const rect = canvas.getBoundingClientRect();
    const w = toWorld(clientX - rect.left, clientY - rect.top);
    const T = getTransform(progress);
    const inv = invMat(T);
    const pre = inv ? mulVec(inv, w) : w;
    const len = Math.hypot(pre[0], pre[1]);
    if (len > 1e-4) {
      xVec = [pre[0] / len, pre[1] / len];
      presetBtns.forEach(b => b.classList.remove('active'));
    }
  }

  canvas.addEventListener('pointerdown', e => {
    dragging = true;
    canvas.setPointerCapture(e.pointerId);
    handleDrag(e.clientX, e.clientY);
  });
  canvas.addEventListener('pointermove', e => {
    if (dragging) handleDrag(e.clientX, e.clientY);
  });
  canvas.addEventListener('pointerup', () => dragging = false);
  canvas.addEventListener('pointercancel', () => dragging = false);

  window.addEventListener('keydown', e => {
    if (e.code === 'Space') { e.preventDefault(); setPlaying(!playing); }
    else if (e.code === 'ArrowRight') { setPlaying(false); targetStep = Math.min(3, Math.floor(progress + 0.01) + 1); }
    else if (e.code === 'ArrowLeft') { setPlaying(false); targetStep = Math.max(0, Math.ceil(progress - 0.01) - 1); }
  });

  requestAnimationFrame(tick);
})();
</script>
</body>
</html>
